# .env.template - Template for Production or Development environment configuration

# ==============================================================================
# BUILD CONFIGURATION
# ==============================================================================
# COMPOSE_TARGET=[prod | dev]
# COMPOSE_PROJECT_NAME=[max | max-dev]
COMPOSE_TARGET=prod
COMPOSE_PROJECT_NAME=max

# ==============================================================================
# HARDWARE CONFIGURATION
# ==============================================================================
# ------------------------------------------------------------------------------
# OPTION A: M4 Mac-Mini (Apple Silicon) Native Setup
# ------------------------------------------------------------------------------
# STT_BASE_IMAGE=python:3.11-slim-bookworm
# COMPOSE_PROFILES=local-only
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ------------------------------------------------------------------------------
# OPTION B: NVIDIA / PC / Production Server Setup
# ------------------------------------------------------------------------------
STT_BASE_IMAGE=nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
OLLAMA_BASE_URL=http://ollama:11434
# STT_DEVICE = [cuda | cpu] (gpu | cpu)
STT_DEVICE=cuda
# STT_COMPUTE_TYPE = [float16 | int8] (gpu | cpu)
STT_COMPUTE_TYPE=float16

# ==============================================================================
# PROXY
# ==============================================================================
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
SERVER_NAME=rb-max.taile1cd92.ts.net
# SSL_CERTIFICATE_PATH="/etc/nginx/certs/${SERVER_NAME}.crt"
# SSL_CERTIFICATE_KEY_PATH="/etc/nginx/certs/${SERVER_NAME}.key"
SSL_CERTIFICATE_PATH="/etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem"
SSL_CERTIFICATE_KEY_PATH="/etc/letsencrypt/live/${SERVER_NAME}/privkey.pem"

# ==============================================================================
# ASSISTANT
# ==============================================================================
ASSISTANT_HOST=assistant
DEFAULT_USERNAME=Margaret.Miller
# Log level is set in max/services/max-assistant/log_config.json

# ==============================================================================
# OLLAMA
# ==============================================================================
# Example Models:
# NAME                                 ID              SIZE
# GPT-oss:20B                          17052f91a42e    13 GB
# qwen3.8:27b                          22130167c4c2    17 GB
# qwen3:14b                            bdbd181c33f2    9.3 GB
# qwen3:4B                             359d7dd4bcda    2.5 GB
# gemma4:E4B                           c6eb396dbd59    9.6 GB
# gemma4:12B                           4eb23ef187e2    7.6 GB
# qwen3.6:27b                          a50eda8ed977    17 GB
# qwen2.5-coder:32b-instruct-q4_K_M    b92d6a0bd47e    19 GB
# qwen2.5:14b                          7cdf5a0187d5    9.0 GB
# qwen2.5-coder:14b                    9ec8897f747e    9.0 GB
# gemma4:26B                           5571076f3d70    17 GB
# llama3.1:8b-instruct-q4_K_M          46e0c10c039e    4.9 GB
# ==============================================================================
OLLAMA_MODEL_NAME=gemma4:26B
OLLAMA_DEBUG=0
OLLAMA_CONTEXT_LENGTH=65536
# macOS
STT_WEBSOCKET_URL=ws://stt/ws

# ==============================================================================
# STT (Speech-to-Text)
# ==============================================================================
STT_MODEL_SIZE=large-v3
STT_LOG_LEVEL=info
# macOS
STT_CPU_THREADS=2
STT_NUM_WORKERS=1

# ==============================================================================
# TTS
# ==============================================================================
TTS_VOICE=en_US-hfc_female-medium
TTS_LOG_LEVEL=info

# ==============================================================================
# NEO4J
# ==============================================================================
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PASSWORD=<!changeme!>
NEO4J_USER=neo4j
NEO4J_URI="bolt://neo4j:${NEO4J_BOLT_PORT}"
# neo4j volume= [neo4j_data | neo4j_data_dev]
NEO4J_VOLUME=neo4j_data

# ==============================================================================
# GMAIL (optional)
# ==============================================================================
GOOGLE_CLIENT_ID=<!changeme!>
GOOGLE_CLIENT_SECRET=<!changeme!>
GOOGLE_SENDER_EMAIL="<!changeme!>t@gmail.com"

# ==============================================================================
# OPTIONAL FEATURES
# ==============================================================================
ENABLE_GPU=true
ENABLE_LOGGING=false

# ==============================================================================
# BIND MOUNTS
# ==============================================================================
# ------------------------------------------------------------------------------
# OPTION A: production - empty (no live reload)
# ------------------------------------------------------------------------------
STT_SRC_MOUNT=
ASSISTANT_SRC_MOUNT=
PROXY_SRC_MOUNT=
PROXY_NODE_MODULES=
# Dev commands for live reload
STT_COMMAND=
ASSISTANT_COMMAND=

# ------------------------------------------------------------------------------
# OPTION B: development - (live reload)
# ------------------------------------------------------------------------------
